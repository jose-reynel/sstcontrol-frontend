<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:SstControl.Frontend.Maui"
             xmlns:sharedComponentes="clr-namespace:SstControl.Frontend.Shared;assembly=SstControl.Frontend.Shared"
             x:Class="SstControl.Frontend.Maui.MainPage"
             BackgroundColor="{StaticResource ColorFondo}">

    <Grid>
        <!-- Toda la interfaz vive en la librería compartida: este control web
             embebido renderiza el mismo Routes.razor que usa la app Web. -->
        <BlazorWebView x:Name="VistaBlazor" HostPage="wwwroot/index.html">
            <BlazorWebView.RootComponents>
                <RootComponent Selector="#app" ComponentType="{x:Type sharedComponentes:Routes}" />
            </BlazorWebView.RootComponents>
        </BlazorWebView>
    </Grid>

</ContentPage>
