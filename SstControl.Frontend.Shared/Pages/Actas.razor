@page "/actas"
@attribute [Authorize]
@inject ServicioApi Api

<span class="encabezado-pagina__ojo">Reuniones y capacitaciones</span>
<h1>Actas</h1>

@if (_error is not null)
{
    <div class="mensaje-error">@_error</div>
}

<AuthorizeView Context="contextoAuth">
    @{ var puedeCrear = contextoAuth.User.TienePermiso("actas.crear"); }

    @if (puedeCrear)
    {
        <div class="tarjeta">
            <div class="tarjeta__titulo"><h2>Registrar acta</h2></div>
            <EditForm Model="_nueva" OnValidSubmit="CrearAsync">
                <div class="formulario-fila">
                    <div class="campo">
                        <label>Id. de empresa</label>
                        <InputNumber @bind-Value="_nueva.IdEmpresa" />
                    </div>
                    <div class="campo">
                        <label>Id. de sede</label>
                        <InputNumber @bind-Value="_nueva.IdSede" />
                    </div>
                    <div class="campo">
                        <label>Tipo</label>
                        <InputSelect @bind-Value="_nueva.Tipo">
                            <option value="Reunion">Reunión</option>
                            <option value="Capacitacion">Capacitación</option>
                        </InputSelect>
                    </div>
                    <div class="campo">
                        <label>Fecha</label>
                        <InputDate @bind-Value="_nueva.Fecha" />
                    </div>
                </div>
                <div class="campo">
                    <label>Título</label>
                    <InputText @bind-Value="_nueva.Titulo" />
                </div>
                <div class="formulario-fila">
                    <div class="campo">
                        <label>Asistentes</label>
                        <InputTextArea @bind-Value="_nueva.Asistentes" />
                    </div>
                    <div class="campo">
                        <label>Notas</label>
                        <InputTextArea @bind-Value="_nueva.Notas" />
                    </div>
                </div>
                <button type="submit" class="boton boton--primario" disabled="@_guardando">
                    @(_guardando ? "Registrando…" : "Registrar acta")
                </button>
            </EditForm>
        </div>
    }

    <div class="tarjeta">
        @if (_cargando && _pagina.Elementos.Count == 0)
        {
            <p class="estado-vacio">Cargando…</p>
        }
        else if (_pagina.Elementos.Count == 0)
        {
            <p class="estado-vacio">Todavía no hay actas registradas, o tu perfil no tiene permiso para verlas.</p>
        }
        else
        {
            <table>
                <thead><tr><th>Fecha</th><th>Tipo</th><th>Título</th><th>Creó</th><th></th></tr></thead>
                <tbody>
                    @foreach (var acta in _pagina.Elementos)
                    {
                        <tr>
                            <td class="dato-mono">@acta.Fecha</td>
                            <td>@(acta.Tipo == "Capacitacion" ? "Capacitación" : "Reunión")</td>
                            <td>@acta.Titulo</td>
                            <td>@acta.NombreCreador</td>
                            <td>
                                <a class="boton boton--pequeno" href="@($"/actas/{acta.IdActa}/compromisos?titulo={Uri.EscapeDataString(acta.Titulo)}")">
                                    Compromisos
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <div style="display:flex;justify-content:space-between;align-items:center;margin-top:1rem;">
                <span class="estado-vacio" style="padding:0;">
                    Mostrando @_pagina.Elementos.Count de @_pagina.TotalElementos acta(s)
                </span>
                @if (_pagina.HayMas)
                {
                    <button class="boton boton--pequeno" disabled="@_cargando" @onclick="CargarMasAsync">
                        @(_cargando ? "Cargando…" : "Cargar más")
                    </button>
                }
            </div>
        }
    </div>
</AuthorizeView>

@code {
    private const int TamanioPagina = 20;

    private bool _cargando = true;
    private bool _guardando;
    private string? _error;
    private PaginaDto<ActaDto> _pagina = new([], 1, TamanioPagina, 0);
    private readonly ModeloActa _nueva = new();

    protected override async Task OnInitializedAsync() => await CargarAsync(1);

    private async Task CargarAsync(int pagina)
    {
        _cargando = true;
        // No se limpia _error acá: si el usuario no tiene permiso "actas.ver" la
        // API responde 403 y queremos que ese mensaje quede visible en pantalla,
        // no un estado vacío silencioso indistinguible de "todavía no hay actas".
        try
        {
            var nuevaPagina = await Api.ObtenerActasAsync(pagina, TamanioPagina);
            _pagina = pagina == 1
                ? nuevaPagina
                : nuevaPagina with { Elementos = [.. _pagina.Elementos, .. nuevaPagina.Elementos] };
            _error = null;
        }
        catch (ExcepcionApi ex) { _error = ex.Message; }
        finally { _cargando = false; }
    }

    private Task CargarMasAsync() => CargarAsync(_pagina.Pagina + 1);

    private async Task CrearAsync()
    {
        _guardando = true;
        try
        {
            var datos = new CrearActaDto(_nueva.IdEmpresa, _nueva.IdSede, _nueva.Tipo, _nueva.Titulo, _nueva.Fecha,
                _nueva.Asistentes, _nueva.Notas);
            await Api.CrearActaAsync(datos);
            _nueva.Titulo = "";
            _nueva.Asistentes = null;
            _nueva.Notas = null;
            await CargarAsync(1);
        }
        catch (ExcepcionApi ex) { _error = ex.Message; }
        finally { _guardando = false; }
    }

    private class ModeloActa
    {
        public int IdEmpresa { get; set; }
        public int IdSede { get; set; }
        public string Tipo { get; set; } = "Reunion";
        public string Titulo { get; set; } = "";
        public DateOnly Fecha { get; set; } = DateOnly.FromDateTime(DateTime.Today);
        public string? Asistentes { get; set; }
        public string? Notas { get; set; }
    }
}
