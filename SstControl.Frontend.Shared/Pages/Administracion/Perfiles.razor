@page "/administracion/perfiles"
@attribute [Authorize]
@inject ServicioApi Api

<span class="encabezado-pagina__ojo">Administración · Control de acceso</span>
<h1>Perfiles</h1>

<div class="tarjeta">
    @if (_cargando)
    {
        <p class="estado-vacio">Cargando…</p>
    }
    else if (_perfiles.Count == 0)
    {
        <p class="estado-vacio">No hay perfiles registrados.</p>
    }
    else
    {
        <table>
            <thead><tr><th>Nombre</th><th>Descripción</th><th>Permisos</th></tr></thead>
            <tbody>
                @foreach (var perfil in _perfiles)
                {
                    <tr>
                        <td><strong>@perfil.Nombre</strong></td>
                        <td>@(perfil.Descripcion ?? "—")</td>
                        <td class="dato-mono">@string.Join(", ", perfil.CodigosPermiso)</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    private bool _cargando = true;
    private List<PerfilDto> _perfiles = [];

    protected override async Task OnInitializedAsync()
    {
        _perfiles = await Api.ObtenerPerfilesAsync();
        _cargando = false;
    }
}
