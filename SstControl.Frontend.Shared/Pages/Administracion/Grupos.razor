@page "/administracion/grupos"
@attribute [Authorize]
@inject ServicioApi Api

<span class="encabezado-pagina__ojo">Administración · Control de acceso</span>
<h1>Grupos</h1>

<div class="tarjeta">
    @if (_cargando)
    {
        <p class="estado-vacio">Cargando…</p>
    }
    else if (_grupos.Count == 0)
    {
        <p class="estado-vacio">No hay grupos registrados.</p>
    }
    else
    {
        <table>
            <thead><tr><th>Nombre</th><th>Integrantes</th></tr></thead>
            <tbody>
                @foreach (var grupo in _grupos)
                {
                    <tr>
                        <td><strong>@grupo.Nombre</strong></td>
                        <td>@(grupo.UsuariosDelGrupo.Count == 0 ? "—" : string.Join(", ", grupo.UsuariosDelGrupo))</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    private bool _cargando = true;
    private List<GrupoDto> _grupos = [];

    protected override async Task OnInitializedAsync()
    {
        _grupos = await Api.ObtenerGruposAsync();
        _cargando = false;
    }
}
