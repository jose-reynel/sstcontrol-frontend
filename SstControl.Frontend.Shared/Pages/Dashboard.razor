@page "/"
@attribute [Authorize]
@inject ServicioApi Api

<span class="encabezado-pagina__ojo">Panel</span>
<h1>Resumen general</h1>

@if (_cargando)
{
    <p class="estado-vacio">Cargando…</p>
}
else
{
    <div class="rejilla-resumen">
        <div class="tarjeta-resumen">
            <div class="tarjeta-resumen__cifra">@_totalEmpresas</div>
            <div class="tarjeta-resumen__etiqueta">Empresas registradas</div>
        </div>
        <div class="tarjeta-resumen">
            <div class="tarjeta-resumen__cifra">@_documentosRecientes.Count(EstaPendienteVigente)</div>
            <div class="tarjeta-resumen__etiqueta">Documentos pendientes de firma (últimos @_documentosRecientes.Count)</div>
        </div>
        <div class="tarjeta-resumen">
            <div class="tarjeta-resumen__cifra">@_documentosRecientes.Count(EstaVencido)</div>
            <div class="tarjeta-resumen__etiqueta">Documentos vencidos (últimos @_documentosRecientes.Count)</div>
        </div>
        <div class="tarjeta-resumen">
            <div class="tarjeta-resumen__cifra">@_totalActas</div>
            <div class="tarjeta-resumen__etiqueta">Actas registradas</div>
        </div>
    </div>

    <div class="tarjeta">
        <div class="tarjeta__titulo"><h2>Últimos documentos</h2><a href="/documentos">Ver todos</a></div>
        @if (_documentosRecientes.Count == 0)
        {
            <p class="estado-vacio">Todavía no hay documentos registrados.</p>
        }
        else
        {
            <table>
                <thead><tr><th>Colaborador</th><th>Tipo</th><th>Vence</th><th>Estado</th></tr></thead>
                <tbody>
                    @foreach (var doc in _documentosRecientes)
                    {
                        <tr>
                            <td>@doc.NombreColaborador</td>
                            <td>@doc.NombreTipo</td>
                            <td class="dato-mono">@doc.FechaVencimiento</td>
                            <td><EstadoDocumento Estado="@doc.Estado" FechaVencimiento="@doc.FechaVencimiento" /></td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
}

@code {
    private bool _cargando = true;
    private int _totalEmpresas;
    private int _totalActas;
    private List<DocumentoDto> _documentosRecientes = [];

    protected override async Task OnInitializedAsync()
    {
        var empresas = await Api.ObtenerEmpresasAsync();
        _totalEmpresas = empresas.Count;

        var paginaDocumentos = await Api.ObtenerDocumentosAsync(pagina: 1, tamanioPagina: 5);
        _documentosRecientes = paginaDocumentos.Elementos;

        // Actas requiere el permiso "actas.ver"; si el usuario no lo tiene, la API
        // responde 403 y aquí simplemente lo tratamos como "sin actas visibles".
        try { _totalActas = (await Api.ObtenerActasAsync(pagina: 1, tamanioPagina: 1)).TotalElementos; }
        catch (ExcepcionApi) { _totalActas = 0; }

        _cargando = false;
    }

    private static bool EstaVencido(DocumentoDto d) => d.Estado == "Pendiente" && d.FechaVencimiento < DateOnly.FromDateTime(DateTime.Today);
    private static bool EstaPendienteVigente(DocumentoDto d) => d.Estado == "Pendiente" && d.FechaVencimiento >= DateOnly.FromDateTime(DateTime.Today);
}
