@page "/documentos"
@attribute [Authorize]
@inject ServicioApi Api

<span class="encabezado-pagina__ojo">Gestión documental</span>
<h1>Documentos</h1>

@if (_error is not null)
{
    <div class="mensaje-error">@_error</div>
}

<AuthorizeView Context="contextoAuth">
    @{
        var puedeFirmar = contextoAuth.User.TienePermiso("documentos.firmar");
        var puedeEliminar = contextoAuth.User.TienePermiso("documentos.eliminar");
    }

    <div class="tarjeta">
        <div class="tarjeta__titulo"><h2>Registrar documento</h2></div>
        <EditForm Model="_nuevo" OnValidSubmit="CrearAsync">
            <div class="formulario-fila">
                <div class="campo">
                    <label>Id. de tipo de documento</label>
                    <InputNumber @bind-Value="_nuevo.IdTipoDocumento" />
                </div>
                <div class="campo">
                    <label>Colaborador</label>
                    <InputText @bind-Value="_nuevo.NombreColaborador" />
                </div>
                <div class="campo">
                    <label>Actividad</label>
                    <InputText @bind-Value="_nuevo.Actividad" />
                </div>
                <div class="campo">
                    <label>Fecha de vencimiento</label>
                    <InputDate @bind-Value="_nuevo.FechaVencimiento" />
                </div>
            </div>
            <p style="font-size:.78rem;color:var(--color-tinta-suave);margin:-.3rem 0 .8rem;">
                El catálogo de tipos de documento aún no tiene un endpoint de consulta en la API —
                por ahora se ingresa el identificador numérico directamente.
            </p>
            <button type="submit" class="boton boton--primario" disabled="@_guardando">
                @(_guardando ? "Registrando…" : "Registrar documento")
            </button>
        </EditForm>
    </div>

    <div class="tarjeta">
        @if (_cargando && _pagina.Elementos.Count == 0)
        {
            <p class="estado-vacio">Cargando…</p>
        }
        else if (_pagina.Elementos.Count == 0)
        {
            <p class="estado-vacio">Todavía no hay documentos registrados.</p>
        }
        else
        {
            <table>
                <thead>
                    <tr>
                        <th>Colaborador</th><th>Tipo</th><th>Actividad</th><th>Captura</th><th>Vence</th><th>Estado</th><th>Aprobó</th><th>Escaneo físico</th><th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var doc in _pagina.Elementos)
                    {
                        <tr>
                            <td>@doc.NombreColaborador</td>
                            <td>@doc.NombreTipo</td>
                            <td>@doc.Actividad</td>
                            <td class="dato-mono">@doc.FechaCaptura</td>
                            <td class="dato-mono">@doc.FechaVencimiento</td>
                            <td><EstadoDocumento Estado="@doc.Estado" FechaVencimiento="@doc.FechaVencimiento" /></td>
                            <td>@(doc.NombreQuienAprueba ?? "—")</td>
                            <td>
                                @if (_idDocumentoEscaneando == doc.IdDocumento)
                                {
                                    <span class="estado-vacio" style="padding:0;">Procesando OCR…</span>
                                }
                                else
                                {
                                    <div style="display:flex;flex-direction:column;gap:.3rem;align-items:flex-start;">
                                        <InputFile OnChange="e => EscanearAsync(doc.IdDocumento, e)" accept="image/jpeg,image/png,image/bmp,image/tiff" />
                                        @if (_escaneos.TryGetValue(doc.IdDocumento, out var escaneo) && escaneo is not null)
                                        {
                                            <button class="boton boton--pequeno" @onclick="() => AlternarDetalleAsync(doc.IdDocumento)">
                                                @(escaneo.Confianza is { } c ? $"Ver texto ({c:0}% confianza)" : "Ver texto")
                                            </button>
                                        }
                                        else if (!_escaneos.ContainsKey(doc.IdDocumento))
                                        {
                                            <button class="boton boton--pequeno" @onclick="() => AlternarDetalleAsync(doc.IdDocumento)">¿Ya está escaneado?</button>
                                        }
                                    </div>
                                }
                            </td>
                            <td style="display:flex;gap:.4rem;">
                                @if (puedeFirmar && doc.Estado == "Pendiente")
                                {
                                    <button class="boton boton--pequeno" @onclick="() => FirmarAsync(doc.IdDocumento)">Firmar</button>
                                }
                                <button class="boton boton--pequeno" @onclick="() => RenovarAsync(doc.IdDocumento)">Renovar</button>
                                @if (puedeEliminar)
                                {
                                    <button class="boton boton--pequeno boton--peligro" @onclick="() => EliminarAsync(doc.IdDocumento)">Eliminar</button>
                                }
                            </td>
                        </tr>
                        @if (_filaExpandida == doc.IdDocumento && _escaneos.TryGetValue(doc.IdDocumento, out var detalle))
                        {
                            <tr>
                                <td colspan="9" style="background:var(--color-fondo);">
                                    @if (detalle is null)
                                    {
                                        <span class="estado-vacio" style="padding:0;">Este documento todavía no tiene ningún escaneo registrado.</span>
                                    }
                                    else
                                    {
                                        <strong>@detalle.NombreArchivoOriginal</strong>
                                        <span style="color:var(--color-tinta-suave);"> — escaneado @detalle.FechaEscaneo.ToLocalTime().ToString("g")</span>
                                        <p style="white-space:pre-wrap;margin:.5rem 0 0;">@(detalle.TextoExtraido ?? "No se reconoció texto en la imagen.")</p>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>

            <div style="display:flex;justify-content:space-between;align-items:center;margin-top:1rem;">
                <span class="estado-vacio" style="padding:0;">
                    Mostrando @_pagina.Elementos.Count de @_pagina.TotalElementos documento(s)
                </span>
                @if (_pagina.HayMas)
                {
                    <button class="boton boton--pequeno" disabled="@_cargando" @onclick="CargarMasAsync">
                        @(_cargando ? "Cargando…" : "Cargar más")
                    </button>
                }
            </div>
        }
    </div>
</AuthorizeView>

@code {
    private const int TamanioPagina = 20;

    private bool _cargando = true;
    private bool _guardando;
    private string? _error;
    private PaginaDto<DocumentoDto> _pagina = new([], 1, TamanioPagina, 0);
    private readonly ModeloDocumento _nuevo = new();

    // ---- Escaneo (OCR) ----
    private int? _idDocumentoEscaneando;
    private int? _filaExpandida;
    private readonly Dictionary<int, DigitalizacionDocumentoDto?> _escaneos = [];

    protected override async Task OnInitializedAsync() => await CargarAsync(1);

    private async Task CargarAsync(int pagina)
    {
        _cargando = true;
        _error = null;
        try
        {
            var nuevaPagina = await Api.ObtenerDocumentosAsync(pagina, TamanioPagina);
            _pagina = pagina == 1
                ? nuevaPagina
                : nuevaPagina with { Elementos = [.. _pagina.Elementos, .. nuevaPagina.Elementos] };
        }
        catch (ExcepcionApi ex) { _error = ex.Message; }
        finally { _cargando = false; }
    }

    private Task CargarMasAsync() => CargarAsync(_pagina.Pagina + 1);

    private async Task CrearAsync()
    {
        _guardando = true;
        _error = null;
        try
        {
            var datos = new CrearDocumentoDto(_nuevo.IdTipoDocumento, _nuevo.NombreColaborador, _nuevo.Actividad,
                _nuevo.FechaVencimiento, null, null);
            await Api.CrearDocumentoAsync(datos);
            _nuevo.NombreColaborador = "";
            _nuevo.Actividad = "";
            await CargarAsync(1);
        }
        catch (ExcepcionApi ex) { _error = ex.Message; }
        finally { _guardando = false; }
    }

    private async Task FirmarAsync(int id) => await EjecutarAccionAsync(() => Api.FirmarDocumentoAsync(id));
    private async Task RenovarAsync(int id) => await EjecutarAccionAsync(() => Api.RenovarDocumentoAsync(id));
    private async Task EliminarAsync(int id) => await EjecutarAccionAsync(() => Api.EliminarDocumentoAsync(id));

    private async Task EjecutarAccionAsync(Func<Task> accion)
    {
        _error = null;
        try { await accion(); await CargarAsync(1); }
        catch (ExcepcionApi ex) { _error = ex.Message; }
    }

    /// <summary>Sube la foto/imagen seleccionada y ejecuta OCR sobre ella. El tamaño
    /// máximo (15 MB) debe coincidir con el límite real que aplica el backend
    /// (RequestSizeLimit en DocumentosControlador) — se valida acá también para dar
    /// el error de inmediato, sin esperar el viaje de ida y vuelta a la API.</summary>
    private async Task EscanearAsync(int idDocumento, InputFileChangeEventArgs evento)
    {
        const long tamanioMaximoBytes = 15 * 1024 * 1024;
        var archivo = evento.File;
        if (archivo.Size > tamanioMaximoBytes)
        {
            _error = $"\"{archivo.Name}\" supera el máximo permitido de 15 MB.";
            return;
        }

        _idDocumentoEscaneando = idDocumento;
        _error = null;
        try
        {
            await using var flujo = archivo.OpenReadStream(tamanioMaximoBytes);
            var resultado = await Api.EscanearDocumentoAsync(idDocumento, flujo, archivo.Name, archivo.ContentType);
            _escaneos[idDocumento] = resultado;
            _filaExpandida = idDocumento;
        }
        catch (ExcepcionApi ex) { _error = ex.Message; }
        finally { _idDocumentoEscaneando = null; }
    }

    /// <summary>Muestra/oculta el texto reconocido de un documento ya escaneado
    /// (en esta sesión, o consultado por primera vez ahora mismo).</summary>
    private async Task AlternarDetalleAsync(int idDocumento)
    {
        if (_filaExpandida == idDocumento) { _filaExpandida = null; return; }

        if (!_escaneos.ContainsKey(idDocumento))
        {
            try { _escaneos[idDocumento] = await Api.ObtenerEscaneoAsync(idDocumento); }
            catch (ExcepcionApi ex) { _error = ex.Message; return; }
        }
        _filaExpandida = idDocumento;
    }

    private class ModeloDocumento
    {
        public int IdTipoDocumento { get; set; } = 1;
        public string NombreColaborador { get; set; } = "";
        public string Actividad { get; set; } = "";
        public DateOnly FechaVencimiento { get; set; } = DateOnly.FromDateTime(DateTime.Today.AddDays(30));
    }
}
